# Machine-specific build settings. Copy to local.env (gitignored); build.sh
# sources it. All values are optional — see the header of build.sh.

# Where the game is installed (the folder containing SongsOfSyx.jar).
#SYX_GAME_DIR="$HOME/.steam/steam/steamapps/common/Songs of Syx"

# JDK 21 to build with (default: tools/jdk21, then JAVA_HOME, then PATH).
#SYX_JDK="/usr/lib/jvm/java-21-openjdk"

# Where to install the built mod (default: the game's data dir for this OS).
#SYX_MODS_DIR="$HOME/.local/share/songsofsyx/mods"

# Extra mods dirs to install into as well, colon-separated. Example: Steam
# running the game through Proton keeps its data inside the Wine prefix.
#SYX_EXTRA_MODS_DIRS="$HOME/.steam/steam/steamapps/compatdata/1162750/pfx/drive_c/users/steamuser/AppData/Roaming/songsofsyx/mods"
